# Shared server-side key that powers the free tier (Groq, meta-llama/llama-4-scout).
# Get one at https://console.groq.com/keys.
GROQ_API_KEY=

# Required for the GitHub-fetch phase — raises the GitHub API rate limit from
# 60/hr to 5000/hr, and unauthenticated requests are prone to 401s in practice.
# Create a fine-grained token (Public Repositories, read-only) at
# https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=

# Used only for BYOK "gemini" provider selection — not the shared free tier.
# Get one at https://aistudio.google.com/apikey — must start with "AIza".
GEMINI_API_KEY=
